{
  "name": "@geniushub/gmail-mcp",
  "version": "1.3.0",
  "mcpName": "io.github.roylam-beep/Gmail-MCP-Server-jev",
  "description": "Lean Gmail MCP server with auto authentication support (maintained fork of ArtyMcLabin/Gmail-MCP-Server)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "vitest run",
    "test:watch": "vitest",
    "lockfile:lint": "lockfile-lint --path package-lock.json --type npm --validate-https --allowed-hosts npm",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "setup": "npm run build && node dist/setup-wizard.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gmail",
    "mcp",
    "cursor",
    "ai",
    "oauth",
    "model-context-protocol",
    "google-gmail",
    "claude",
    "auto-auth"
  ],
  "author": "roylam-beep",
  "contributors": [
    "Arty McLabin (upstream fork author)",
    "gongrzhe (original upstream author)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roylam-beep/Gmail-MCP-Server-jev.git"
  },
  "bugs": {
    "url": "https://github.com/roylam-beep/Gmail-MCP-Server-jev/pulls"
  },
  "homepage": "https://github.com/roylam-beep/Gmail-MCP-Server-jev#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.17",
    "body-parser": "^2.3.0",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.8",
    "ip-address": "^10.7.2",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "email-addresses": "^5.0.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "mime-types": "^3.0.1",
    "nodemailer": "^10.0.10",
    "open": "^10.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.1"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^6.4.17",
    "lockfile-lint": "^5.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  }
}
